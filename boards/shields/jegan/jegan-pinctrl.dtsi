&pinctrl {

  /* spi0 for led strip */
  spi0_default: spi0_default {
    group1 {
      psels
        = <NRF_PSEL(SPIM_SCK, 1, 101)>,
          <NRF_PSEL(SPIM_MOSI, 0, 22)>,
          <NRF_PSEL_DISCONNECTED(SPIM_MISO)>
        ;
    };
  };

  spi0_sleep: spi0_sleep {
    group1 {
      psels
        = <NRF_PSEL(SPIM_SCK, 1, 101)>,
          <NRF_PSEL(SPIM_MOSI, 0, 22)>,
          <NRF_PSEL_DISCONNECTED(SPIM_MISO)>
        ;
      low-power-enable;
    };
  };
};
