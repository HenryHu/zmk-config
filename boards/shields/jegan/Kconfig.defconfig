if SHIELD_JEGAN_LEFT

config ZMK_KEYBOARD_NAME
    default "jegan"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_DISPLAY
    default y

config CONFIG_ZMK_DISPLAY_BLANK_ON_IDLE
    default y

config ONFIG_ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN
    default y

config ONFIG_ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    default n

config ONFIG_ZMK_DISPLAY_WORK_QUEUE_DEDICATED
    default y

config ONFIG_ZMK_WIDGET_OUTPUT_STATUS
    default y

config CONFIG_ZMK_WIDGET_LAYER_STATUS
    default y

config CONFIG_ZMK_WIDGET_BATTERY_STATUS
    default y

endif # SHIELD_JEGAN_LEFT

if SHIELD_JEGAN_LEFT || SHIELD_JEGAN_RIGHT

config ZMK_SPLIT
    default y

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1

endchoice

endif # LVGL

endif # SHIELD_JEGAN_LEFT || SHIELD_JEGAN_RIGHT
