if SHIELD_JEGAN_LEFT

config ZMK_KEYBOARD_NAME
    default "jegan"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_DISPLAY
    default y

config ZMK_DISPLAY_BLANK_ON_IDLE
    default y

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN
    #default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

config ZMK_WIDGET_OUTPUT_STATUS
    default y

config ZMK_WIDGET_LAYER_STATUS
    default y

config ZMK_WIDGET_BATTERY_STATUS
    default y

endif # SHIELD_JEGAN_LEFT

if SHIELD_JEGAN_LEFT || SHIELD_JEGAN_RIGHT

config ZMK_SPLIT
    default y

config ZMK_RGB_UNDERGLOW
    default y

config ZMK_RGB_UNDERGLOW_AUTO_OFF_USB
    default y

config ZMK_RGB_UNDERGLOW_ON_START
    default y

config ZMK_RGB_UNDERGLOW_EFF_START
    default 2

config LED_STRIP
    default y

config WS2812_STRIP
    default y

choice WS2812_STRIP_DRIVER
    default WS2812_STRIP_SPI
endchoice

config ZMK_RGB_UNDERGLOW_BRT_START
    default 20

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1

endchoice

endif # LVGL

endif # SHIELD_JEGAN_LEFT || SHIELD_JEGAN_RIGHT
